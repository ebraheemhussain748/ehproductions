rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ebraheemhussain748@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // Enquiries from the website form: anyone can send one, only the admin can read them.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'service', 'budget', 'message', 'status', 'source', 'createdAt'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.contact, 120) && request.resource.data.contact.size() > 0
        && str(request.resource.data['service'], 80)
        && str(request.resource.data.budget, 60)
        && str(request.resource.data.message, 2000)
        && str(request.resource.data.source, 300)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Client reviews: anyone can submit one, it stays hidden until the admin approves it.
    match /reviews/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'business', 'rating', 'text', 'approved', 'createdAt'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.business, 80)
        && str(request.resource.data.text, 800) && request.resource.data.text.size() > 0
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;
      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
